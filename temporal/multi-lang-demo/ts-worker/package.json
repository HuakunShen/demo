{
  "name": "multi-lang-demo-ts-worker",
  "version": "1.0.0",
  "description": "TypeScript worker and client for multi-language Temporal demo",
  "main": "dist/worker.js",
  "scripts": {
    "worker": "ts-node src/worker.ts",
    "client": "ts-node src/client.ts",
    "stress-test": "ts-node src/stress-test-client.ts",
    "stress-test:small": "ts-node src/stress-test-client.ts 10 2 5",
    "stress-test:medium": "ts-node src/stress-test-client.ts 50 5 10",
    "stress-test:large": "ts-node src/stress-test-client.ts 100 10 10",
    "build": "tsc --build",
    "build-watch": "tsc --build --watch"
  },
  "dependencies": {
    "@temporalio/activity": "^1.8.6",
    "@temporalio/client": "^1.8.6",
    "@temporalio/worker": "^1.8.6",
    "@temporalio/workflow": "^1.8.6",
    "@temporalio/common": "^1.8.6"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  }
}